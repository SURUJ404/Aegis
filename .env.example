# ─────────────────────────────────────────────────────────────────────────────
# Aegis — environment file (template)
#
# Every Rust binary auto-loads a `.env` in the repo root via dotenvy; the
# Python API reads the same names. Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets. This repo's QA secret
# scan found no committed keys anywhere; keep it that way.
#
# All env overrides work with OR without a --config TOML file (Bug R fix).
# ─────────────────────────────────────────────────────────────────────────────

# ── Control-plane API (api-server / trading-engine) ──────────────────────────
# Bearer token for /api/v1/* (except /healthz). Empty/absent = auth disabled.
API_TOKEN=
# API listen address (host:port).
API_BIND=0.0.0.0:8080
# Prometheus metrics listen address.
METRICS_BIND=0.0.0.0:9100
# Optional path to an EngineConfig TOML (docker: /config/lq.toml).
LQ_CONFIG=
# trace | debug | info | warn | error
LQ_LOG_LEVEL=info

# ── Persistence (engine / market-data-service) ───────────────────────────────
# true/1 enables Postgres event persistence.
LQ_PERSISTENCE_ENABLED=false
# Platform connection strings win over the TOML file (Railway/Fly style).
POSTGRES_URL=postgres://lq:lq@localhost:5432/liquidity
# DATABASE_URL is accepted as an alias of POSTGRES_URL.
#DATABASE_URL=postgres://lq:lq@localhost:5432/liquidity
REDIS_URL=redis://localhost:6379

# ── Backtest runner ──────────────────────────────────────────────────────────
# Default JSON output file for `backtest` (--out) and --json emission.
LQ_BACKTEST_OUT=
LQ_BACKTEST_JSON=

# ── Python analysis API (restapis/) ──────────────────────────────────────────
# synthetic | yfinance
DATA_SOURCE=synthetic
# Comma-separated CORS origins (spaces/empty segments are tolerated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Dashboard routing (web/ nginx + docker-compose) ──────────────────────────
# Host the nginx proxy forwards /api and /healthz to (compose: trading-engine).
ENGINE_API_HOST=localhost

# ── docker-compose local-dev services (NOT for production) ───────────────────
POSTGRES_USER=lq
POSTGRES_PASSWORD=lq
POSTGRES_DB=liquidity
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
